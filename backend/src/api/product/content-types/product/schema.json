{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Products"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "sku": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "groupId": {
      "type": "string"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "priceOld": {
      "type": "decimal"
    },
    "stockStatus": {
      "type": "enumeration",
      "default": "inStock",
      "enum": [
        "inStock",
        "outOffStock"
      ]
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "attributes": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "overview": {
      "type": "text",
      "default": "Discover superior performance, modern design, and advanced technology engineered for your daily needs. Experience the next level of quality and reliability."
    },
    "deliveryNotice": {
      "type": "text",
      "default": "Free next-day delivery available"
    },
    "badge": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "new",
        "sale"
      ]
    },
    "variations": {
      "type": "component",
      "component": "products.product-variations",
      "repeatable": true
    },
    "product_categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-category.product-category",
      "inversedBy": "products"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
