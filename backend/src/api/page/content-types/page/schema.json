        "sections.hero-title",
        "sections.faq",
        "sections.contacts",
        "sections.categories",
        "sections.best-products",
        "sections.text-section"
      ]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
