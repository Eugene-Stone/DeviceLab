{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "icon": "search"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "maxLength": 60
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 160
    },
    "keywords": {
      "type": "text"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "metaRobots": {
      "type": "enumeration",
      "enum": [
        "index,follow",
        "noindex,follow",
        "index,nofollow",
        "noindex,nofollow"
      ],
      "default": "index,follow"
    },
    "preventIndexing": {
      "type": "boolean",
      "default": false
    },
    "metaViewport": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "ogUrl": {
      "type": "string"
    },
    "ogType": {
      "type": "string",
      "default": "website"
    },
    "twitterCard": {
      "type": "enumeration",
      "enum": [
        "summary",
        "summary_large_image",
        "app",
        "player"
      ],
      "default": "summary_large_image"
    },
    "twitterTitle": {
      "type": "string"
    },
    "twitterDescription": {
      "type": "text"
    },
    "twitterImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "structuredData": {
      "type": "text"
    }
  }
}
